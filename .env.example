# 환경변수 예시. 복사해서 루트 .env로 저장 후 값 채우기 (.env는 git 제외).
# docker-compose.yml은 ${...}로 참조하는 값만 컨테이너에 넘기고, 네이티브 실행(README §4)에서는 web·portal이 이 파일을 직접 읽는다.

# 하드웨어 목업 모드 (실제 AiHand/picar/micro:bit 연결 전까지 true 유지)
MOCK_HARDWARE=true
# 실제 Raspberry Pi Camera Module 3 연결 전까지 true 유지 (services/vision)
MOCK_CAMERA=true

# 서비스 간 통신 URL (docker-compose 네트워크 내부 기준, 로컬 단독 실행 시 localhost로 변경)
VISION_URL=http://vision:8000
ACTUATION_URL=http://actuation:8000
# picar는 실물 배포 시 별도 보드(Raspberry Pi 4B 8GB)에서 Wi-Fi로 통신한다.
# 아래는 docker-compose 로컬 개발용 값이고, 실물에서는 고정 IP로 교체할 것:
#   PICAR_URL=http://192.168.50.10:8000
# (RPi5를 AP로 띄우는 1:1 무선 직결 + 고정 IP — 11_하드웨어설계서.md §6.1)
PICAR_URL=http://picar:8000
PICAR_TIMEOUT_MS=500
# ↓ 여기부터 CAMERA_FAIL_STREAK_THRESHOLD까지 web 타이밍 값은 네이티브 web 전용 — compose web 컨테이너에는 안 넘어간다
# actuation(AI Hand/micro:bit) 호출 타임아웃 — web_picar_통신_신뢰성_개선안.md §4 C′안(2026-09-23)
# /command는 손 동작이 끝난 뒤 회신해 실측 0.79~0.83초, /result·/progress는 실측 26~42ms
# (이전 C안 0.6초 일괄은 /command가 전부 timeout 나서 철회)
ACTUATION_COMMAND_TIMEOUT_S=1.5
ACTUATION_FEEDBACK_TIMEOUT_S=0.5
# web이 vision GET /latest를 폴링하는 주기
VISION_POLL_INTERVAL_S=0.2
# web이 vision/actuation/picar의 GET /health를 확인하는 주기 (장치 생존 표시용)
DEVICE_HEALTH_INTERVAL_S=5.0
# 판정 단계에서 손 미검출이 연속 몇 회면 SC-04(카메라 위치 조정)로 넘길지 — 25회 ≈ 5초(폴링 0.2초 기준, 14 §9)
CAMERA_FAIL_STREAK_THRESHOLD=25

# 판정 신뢰도 임계값 / 연속 프레임 수 — **평소에는 비워 두세요.**
# 비워 두면 Colab 학습 산출물(services/vision/models/svm_classifier.joblib)에 기록된 값을 쓴다
# (모델과 임계값이 따로 놀지 않게 하기 위함). 모델이 없으면 05_모델카드 §8-0 초기값(0.75 / 3프레임).
# 아래처럼 값을 주면 번들 값을 덮어쓴다 — 운영 중 급히 조여야 할 때만 사용.
# CONFIDENCE_THRESHOLD=0.80
# N_FRAMES=5

# micro:bit는 USB 시리얼이 아니라 **BLE**로 통신한다 (2026-09-21 전환 — micro:bit v2의 하드웨어
# UART가 1개뿐이라 AI Hand 서보 초기화 시 USB 시리얼이 죽는다). 아래는 BLE 스캔에서 찾을 장치
# 이름의 부분 문자열이다 — 실측 이름 예: "BBC micro:bit [zezuz]"
MICROBIT_BLE_NAME=BBC micro:bit

# 회원·학습 결과 저장(Supabase) — 비워 두면 로컬 모드(services/web/supabase/README.md).
# 실제 키는 이 예시 파일에 적지 말고 루트 .env에만 둔다(팀원에게는 파일로 전달).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# 회사 웹사이트(portal) 로그인 쿠키 서명 키 — 32자 이상 임의 문자열(services/portal/README.md)
# PORTAL_SESSION_SECRET=<random-32+-chars>
