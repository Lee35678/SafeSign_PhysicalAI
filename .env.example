# docker-compose.yml에서 사용하는 환경변수 예시. 복사해서 .env로 저장 후 값 채우기.

# 하드웨어 목업 모드 (실제 AiHand/picar/micro:bit 연결 전까지 true 유지)
MOCK_HARDWARE=true
# 실제 Raspberry Pi Camera Module 3 연결 전까지 true 유지 (services/vision)
MOCK_CAMERA=true

# 서비스 간 통신 URL (docker-compose 네트워크 내부 기준, 로컬 단독 실행 시 localhost로 변경)
VISION_URL=http://vision:8000
ACTUATION_URL=http://actuation:8000
# picar는 실물 배포 시 별도 보드(Raspberry Pi 4B 8GB)에서 Wi-Fi로 통신한다.
# 아래는 docker-compose 로컬 개발용 값이고, 실물에서는 고정 IP로 교체할 것:
#   PICAR_URL=http://192.168.50.10:8000
# (RPi5를 AP로 띄우는 1:1 무선 직결 + 고정 IP — 11_하드웨어설계서_v1.md §6.1)
PICAR_URL=http://picar:8000
PICAR_TIMEOUT_MS=500

# 판정 신뢰도 임계값 / 연속 프레임 수 — **평소에는 비워 두세요.**
# 비워 두면 Colab 학습 산출물(services/vision/models/svm_classifier.joblib)에 기록된 값을 쓴다
# (모델과 임계값이 따로 놀지 않게 하기 위함). 모델이 없으면 05_모델카드_v3 §8-0 초기값(0.75 / 3프레임).
# 아래처럼 값을 주면 번들 값을 덮어쓴다 — 운영 중 급히 조여야 할 때만 사용.
# CONFIDENCE_THRESHOLD=0.80
# N_FRAMES=5

# micro:bit는 USB 시리얼이 아니라 **BLE**로 통신한다 (2026-09-21 전환 — micro:bit v2의 하드웨어
# UART가 1개뿐이라 AI Hand 서보 초기화 시 USB 시리얼이 죽는다). 아래는 BLE 스캔에서 찾을 장치
# 이름의 부분 문자열이다 — 실측 이름 예: "BBC micro:bit [zezuz]"
MICROBIT_BLE_NAME=BBC micro:bit
