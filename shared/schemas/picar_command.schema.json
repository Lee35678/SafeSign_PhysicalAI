{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PicarCommand",
  "description": "교육 상태머신(web, RPi5) -> picar 서비스 (Raspberry Pi 4B 8GB, Wi-Fi/HTTP). document/03_인터페이스계약서_v2 §5-2 참고. picar가 주행하면 카메라도 함께 이동하는 문제 때문에 컴퓨트 보드를 분리했다(2026-09-18) — 실제 네트워크 메시지이며, 타임아웃 500ms + 1회 재시도 정책을 따른다.",
  "type": "object",
  "required": ["command", "target_signal", "motor", "led"],
  "properties": {
    "command": {
      "type": "string",
      "enum": ["stop", "slow", "turn_left", "turn_right", "reverse", "caution", "complete"]
    },
    "target_signal": {
      "type": "string",
      "enum": ["정지", "서행", "좌회전_유도", "우회전_유도", "확인_완료", "후진", "주의"]
    },
    "motor": {
      "type": "object",
      "required": ["action", "speed"],
      "properties": {
        "action": { "type": "string", "enum": ["stop", "forward", "backward", "left", "right"] },
        "speed": { "type": "integer", "minimum": 0, "maximum": 100, "description": "%, slow 명령은 정상보다 낮은 고정값 — ⚠️ 실측 후 확정" }
      }
    },
    "led": {
      "type": "object",
      "required": ["red", "yellow_left", "yellow_right"],
      "properties": {
        "red": { "type": "string", "enum": ["off", "on", "blink"] },
        "yellow_left": { "type": "string", "enum": ["off", "on", "blink"] },
        "yellow_right": { "type": "string", "enum": ["off", "on", "blink"] }
      }
    }
  }
}
