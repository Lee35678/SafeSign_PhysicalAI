{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LandmarkFrame",
  "description": "Perception -> Cognition. MediaPipe Hand Landmarker 출력 1프레임. 02_설계문서_v1 / 03_인터페이스계약서_v1 §3 참고.",
  "type": "object",
  "required": ["timestamp", "hand_detected", "landmarks"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO8601" },
    "hand_detected": { "type": "boolean" },
    "field_id": {
      "type": "string",
      "description": "분야 ID (industry|construction|agriculture|underwater). micro:bit 버튼 순환 결과, 시스템_구성도_초안 참고."
    },
    "landmarks": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "z"],
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 20 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" }
        }
      }
    }
  }
}
