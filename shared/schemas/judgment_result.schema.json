{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JudgmentResult",
  "description": "Cognition -> 교육 상태머신(web). 03_인터페이스계약서_v1 §4 참고.",
  "type": "object",
  "required": ["predicted_class", "confidence", "match_score", "is_reject", "latency_ms"],
  "properties": {
    "predicted_class": { "type": "string", "description": "수신호 이름 또는 'negative'" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "match_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "일치율(유사도) 0~100" },
    "is_reject": { "type": "boolean", "description": "신뢰도 임계값(CONFIDENCE_THRESHOLD) 미달 시 true" },
    "latency_ms": { "type": "integer", "minimum": 0, "description": "손 정지 시점 -> 판정 확정까지, P95<=1000 목표" }
  }
}
