{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JudgmentResult",
  "description": "Cognition -> 교육 상태머신(web). document/03_인터페이스계약서_v2 §4 참고.",
  "type": "object",
  "required": ["predicted_class", "confidence", "match_score", "is_reject", "latency_ms"],
  "properties": {
    "predicted_class": { "type": "string", "description": "수신호 이름(7종) 또는 'negative'" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "match_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "일치율(유사도) 0~100. 예측 클래스 템플릿과의 cosine similarity를 매핑한 값" },
    "is_reject": { "type": "boolean", "description": "미판정 여부. τ(CONFIDENCE_THRESHOLD) 미달, 손 미검출, N프레임 미충족 등" },
    "latency_ms": { "type": "integer", "minimum": 0, "description": "캡처 -> 판정 확정까지, P95<=1000 목표" },
    "reason": {
      "type": "string",
      "enum": [
        "no_hand",
        "normalize_failed",
        "model_not_loaded",
        "inference_error",
        "below_tau",
        "awaiting_consecutive_frames"
      ],
      "description": "is_reject=true일 때의 사유. 웹 상태머신이 SC-04(카메라 인식 실패: no_hand/normalize_failed)와 SC-03b(재시도 유도: below_tau 등)를 구분하는 데 쓴다"
    },
    "consecutive": { "type": "integer", "minimum": 0, "description": "현재까지 연속으로 같은 클래스가 나온 프레임 수 (N프레임 판정 안정화 진행도, 05_모델카드_v3 §3-6)" }
  }
}
