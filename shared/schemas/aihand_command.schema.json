{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiHandCommand",
  "description": "교육 상태머신(web) / vision -> actuation. 03_인터페이스계약서_v1 §5-1 참고. servo_angles 값은 실물 테스트 전까지 목업.",
  "type": "object",
  "required": ["command", "target_signal", "servo_angles"],
  "properties": {
    "command": { "type": "string", "enum": ["demo", "correct_pose"] },
    "target_signal": { "type": "string", "description": "수신호 이름 (최종 채택 5종 중 하나)" },
    "servo_angles": {
      "type": "object",
      "required": ["thumb", "index", "middle", "ring", "pinky", "wrist_rotation"],
      "properties": {
        "thumb": { "type": "integer", "minimum": 0, "maximum": 180 },
        "index": { "type": "integer", "minimum": 0, "maximum": 180 },
        "middle": { "type": "integer", "minimum": 0, "maximum": 180 },
        "ring": { "type": "integer", "minimum": 0, "maximum": 180 },
        "pinky": { "type": "integer", "minimum": 0, "maximum": 180 },
        "wrist_rotation": { "type": "integer", "minimum": 0, "maximum": 180, "description": "좌우 회전만 가능, 상하 꺾기 불가 (02_설계문서_v1 §3)" }
      }
    }
  }
}
