# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node (web frontend에서 빌드 도구 사용 시)
node_modules/
dist/

# 환경변수
.env

# 데이터 (원본 촬영본은 용량이 크므로 git 대신 별도 공유 스토리지 사용 권장)
services/data/datasets/raw/*
!services/data/datasets/raw/.gitkeep
services/data/datasets/processed/*
!services/data/datasets/processed/.gitkeep
# 공개 데이터셋(Kaggle) 원본 사진 — 각자 내려받아 사용 (services/data/README.md §5)
services/data/datasets/raw_public/

# MediaPipe 모델 번들 (7.8MB, 실행 시 자동 다운로드)
services/data/models/*.task

# 학습 파이프라인 예행연습용 더미 데이터 (scripts/make_dummy_dataset.py가 언제든 재생성)
services/vision/training/_dummy_dataset/

# 학습된 모델 가중치: Colab 산출물이라 각자 내려받아 넣는다.
# 팀 전체가 같은 모델을 공유해야 할 시점(시연 직전 등)이 오면 아래 두 줄을 지우고 커밋할 것.
services/vision/models/*.joblib
services/vision/models/*.task

# DB 파일
*.sqlite3
*.db

# OS/IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
